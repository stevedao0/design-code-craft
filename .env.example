# VCPMC root environment variables (placeholder names only).
# Copy this file to .env and fill in values for your local environment.
# Never commit the real .env file.

# Identity
APP_NAME=vcpmc-new-app
APP_INSTANCE=local-dev
APP_ENV=development

# Auth & security
DEV_AUTH_ENABLED=false
JWT_SECRET_KEY=<CHANGE_ME_RANDOM_SECRET>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
DATABASE_URL=postgresql://<DB_USER>:<CHANGE_ME>@<DB_HOST>:5432/<DB_NAME>

# CORS — comma separated origins, no trailing slash
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5199,http://localhost:5199

# Internal QR Portal automation
INTERNAL_QR_PORTAL_BASE_URL=https://<QR_PORTAL_HOST>:<PORT>
INTERNAL_QR_PORTAL_USERNAME=<QR_PORTAL_USERNAME>
INTERNAL_QR_PORTAL_PASSWORD=<QR_PORTAL_PASSWORD>
INTERNAL_QR_AUTOMATION_HEADLESS=true
INTERNAL_QR_DOWNLOAD_DIR=<ABSOLUTE_DOWNLOAD_DIR>
INTERNAL_QR_TIMEOUT_SECONDS=60
QR_PORTAL_ALLOW_REMOTE_PLAYWRIGHT=false

# Export / render
EXPORT_TEMPLATE_ROOT=<ABSOLUTE_TEMPLATES_DIR>
EXPORT_OUTPUT_ROOT=<ABSOLUTE_STORAGE_DIR>
PREVIEW_STORAGE_PATH=<ABSOLUTE_PREVIEW_DIR>
EXPORT_RENDER_ENABLED=false
EXPORT_DB_ATTACH_ENABLED=false

# Feature flags
CREATE_CONTRACT_WRITE_ENABLED=false
CREATE_CONTRACT_ROLLBACK_ONLY=true
CREATE_CONTRACT_PERSIST_TEST_ONLY=false
CREATE_CONTRACT_CLONE_ONLY_ENABLED=false
CREATE_CERTIFICATE_WRITE_ENABLED=true
CREATE_CERTIFICATE_DRAFT_ONLY_ENABLED=false
CREATE_CERTIFICATE_CLONE_ONLY_ENABLED=false
ASSIGN_CERTIFICATE_NUMBER_ENABLED=true
UPDATE_CERTIFICATE_ENABLED=true
SYNC_CERTIFICATE_ENABLED=true
PRINT_CERTIFICATE_ENABLED=true
DELETE_CONTRACT_MAIN_DB_ENABLED=false
ADMIN_DELETE_ANY_CONTRACT_CLONE_ENABLED=false
ADMIN_DELETE_FINAL_CERTIFICATE_CLONE_ENABLED=false