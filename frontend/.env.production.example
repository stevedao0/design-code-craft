# Frontend Production Environment Template
# =========================================
# COPY this file to .env.production and fill in values if needed.
# The .env.production file MUST NOT be committed to version control.
# See docs/production-env.md for full instructions.
# =========================================

# API base URL — use relative path so it works with any domain.
# The frontend will call /api/* which routes through Caddy/Nginx to the backend.
VITE_API_BASE_URL=/api

# App identity (display only, no security impact).
VITE_APP_NAME=VCPMC_NEW_APP
VITE_APP_INSTANCE=vcpmc-prod

# Feature flags visible in the UI (copied from backend).
# These override the server-side defaults for the frontend.
VITE_DEV_AUTH_ENABLED=false

# =========================================
# NOTE: VITE_ prefix is required for Vite to expose env vars to the frontend.
# =========================================
