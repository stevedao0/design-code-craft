# VCPMC Production Environment Template
# =========================================
# COPY this file to .env.production and fill in the REQUIRED values.
# The .env.production file MUST NOT be committed to version control.
# See docs/production-env.md for full instructions.
# =========================================

# =========================================
# IDENTITY
# =========================================
APP_NAME=VCPMC_NEW_APP
APP_INSTANCE=vcpmc-prod
APP_ENV=production
NODE_ENV=production

# =========================================
# AUTH & SECURITY
# =========================================
# REQUIRED: Set to false in production.
DEV_AUTH_ENABLED=false

# REQUIRED: Generate a strong random 256-bit (64 hex chars) secret.
# Do NOT use: dev_only_change_later, any placeholder, or the dev secret.
# Example: openssl rand -hex 32
JWT_SECRET_KEY=<CHANGE_ME_256BIT_RANDOM_SECRET>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# =========================================
# DATABASE
# =========================================
# REQUIRED: Use a strong password for the production DB user.
# REQUIRED: POSTGRES_PASSWORD and the password in DATABASE_URL must MATCH.
# Use the same password in both places when filling in .env.production.
# Database mode: "main" for production (single DB, no clone workflow).
DB_MODE=main

# PostgreSQL password — used by docker-compose postgres service.
# MUST match the password in DATABASE_URL below.
# Generate: openssl rand -hex 16
POSTGRES_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

# REQUIRED: Use the SAME password as POSTGRES_PASSWORD above.
# - Docker Compose: use the service name "postgres" (matches docker-compose.yml).
# - Standalone: use the hostname of the PostgreSQL server.
# Database name: vcpmc_contract (keep as is — matches existing schema).
DATABASE_URL=postgresql://vcpmc_user:<CHANGE_ME_STRONG_PASSWORD>@postgres:5432/vcpmc_contract

# =========================================
# CORS
# =========================================
# REQUIRED: Change to your actual production domain.
# - Must be the exact HTTPS URL of the app (e.g. https://app.vcpmc.domain).
# - Do NOT use "*" in production.
# - Do NOT include trailing slash.
CORS_ALLOWED_ORIGINS=https://<YOUR_APP_DOMAIN>

# =========================================
# CONTRACT FEATURE FLAGS
# =========================================
# Production: enable direct writes to the main database.
CREATE_CONTRACT_WRITE_ENABLED=true
CREATE_CONTRACT_ROLLBACK_ONLY=false
CREATE_CONTRACT_PERSIST_TEST_ONLY=false
CREATE_CONTRACT_CLONE_ONLY_ENABLED=false

# =========================================
# CERTIFICATE / GCN FEATURE FLAGS
# =========================================
CREATE_CERTIFICATE_WRITE_ENABLED=true
CREATE_CERTIFICATE_DRAFT_ONLY_ENABLED=false
CREATE_CERTIFICATE_CLONE_ONLY_ENABLED=false
ASSIGN_CERTIFICATE_NUMBER_ENABLED=true
UPDATE_CERTIFICATE_ENABLED=true
SYNC_CERTIFICATE_ENABLED=true
PRINT_CERTIFICATE_ENABLED=true

# =========================================
# EXPORT / RENDER
# =========================================
# Container paths — mount ./storage and ./templates at these paths.
# These are the paths inside the Docker container.
EXPORT_TEMPLATE_ROOT=/app/templates
EXPORT_OUTPUT_ROOT=/app/storage
PREVIEW_STORAGE_PATH=/app/storage/preview

# Enable DOCX rendering (requires LibreOffice in container, optional).
# Set to false if rendering is not needed or LibreOffice is not installed.
EXPORT_RENDER_ENABLED=false

# Attach rendered DOCX to records (requires EXPORT_RENDER_ENABLED=true).
EXPORT_DB_ATTACH_ENABLED=false

# =========================================
# INTERNAL QR PORTAL AUTOMATION
# =========================================
# QR Portal URL — keep the existing internal IP/port.
# Do NOT change this in Phase 1. The extension uses this URL.
INTERNAL_QR_PORTAL_BASE_URL=http://14.241.251.220:7879
INTERNAL_QR_PORTAL_USERNAME=<QR_PORTAL_USERNAME>
# REQUIRED: Set the actual QR Portal password.
INTERNAL_QR_PORTAL_PASSWORD=<QR_PORTAL_PASSWORD>
INTERNAL_QR_AUTOMATION_HEADLESS=true

# Path inside container for QR downloads.
# Mount ./storage at /app/storage to persist this across restarts.
INTERNAL_QR_DOWNLOAD_DIR=/app/storage/gcn_qr
INTERNAL_QR_TIMEOUT_SECONDS=60

# Remote browser safety:
# - false: Only localhost clients can trigger Playwright automation.
#   Remote clients see the "Mở portal thủ công" fallback button.
# - true: Allow from any client, but Playwright opens on the BACKEND machine.
#   Set to true only if you understand the security implications.
QR_PORTAL_ALLOW_REMOTE_PLAYWRIGHT=false

# =========================================
# DELETE FLAGS (enable with caution)
# =========================================
DELETE_CONTRACT_MAIN_DB_ENABLED=false
ADMIN_DELETE_ANY_CONTRACT_CLONE_ENABLED=false
ADMIN_DELETE_FINAL_CERTIFICATE_CLONE_ENABLED=false
