{
  "name": "vcpmc-root",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "cd frontend && ./node_modules/.bin/vite --host 0.0.0.0 --port 8080",
    "dev:all": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-all.ps1",
    "dev:all:noinstall": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-all.ps1 -SkipFrontendInstall",
    "dev:watch": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-all.ps1 -StartFrontendWatcher",
    "build": "npm run frontend:build",
    "frontend:install": "npm --prefix frontend install",
    "frontend:build": "npm --prefix frontend run build",
    "preview": "cd frontend && ./node_modules/.bin/vite preview --host 0.0.0.0 --port 8080",
    "postinstall": "cd frontend && npm install",
    "build:dev": "cd frontend && ./node_modules/.bin/vite build --mode development --outDir ../dist --emptyOutDir",
    "backend:venv": "powershell -ExecutionPolicy Bypass -File ./scripts/ensure-venv.ps1",
    "backend:install": "powershell -ExecutionPolicy Bypass -File ./scripts/ensure-venv.ps1 -InstallRequirements",
    "backend:start": "powershell -ExecutionPolicy Bypass -Command \"Set-Location 'F:\\APPs\\backend'; & 'F:\\APPs\\.venv\\Scripts\\python.exe' -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload\""
  },
  "devDependencies": {
    "jsdom": "^29.1.1"
  }
}
